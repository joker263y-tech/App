; Engine configuration file.
; Shadowbound: The Last Night — Godot 4.5 project.
;
; The engine-free core rules live in Core/ (plain C#) and are referenced by
; Shadowbound.csproj. Everything under scripts/ is the Godot presentation
; layer: it copies state from the core and never writes positions back.

config_version=5

[application]

config/name="Shadowbound: The Last Night"
config/description="An original dark-fantasy 3D action RPG. Godot 4.5 port of the project's engine-free C# core."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/version="1.0.0"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; 0 = Landscape (the Android target orientation this project has always used).
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Shadowbound"

[input]

