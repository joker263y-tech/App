[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="combatants"
3d_physics/layer_3="camera_blockers"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
; Android requires ETC2/ASTC texture compression; without this the Android
; exporter refuses the project (it is a hard requirement, not a warning).
textures/vram_compression/import_etc2_astc=true
