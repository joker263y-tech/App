# output must never be committed, and must never be picked up by Unity.
Tests/**/bin/
Tests/**/obj/
[Tt]ools/**/bin/
[Tt]ools/**/obj/
**/TestResults/
*.trx
*.coverage
*.nupkg

# Local override files
*.local.json
.env
