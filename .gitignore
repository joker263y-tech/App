# ==============================================================================
# SHADOWBOUND: THE LAST NIGHT - Git ignore
# Unreal Engine 5 is the primary engine. The old Unity folders are gone; this
# file ignores what Unreal and the command-line harnesses generate.
# ==============================================================================

# ------------------------------ Unreal generated ------------------------------
# All of these are machine-specific and regenerated by a build.
/Binaries/
/Build/
/DerivedDataCache/
/Intermediate/
/Saved/
/Platforms/*/Binaries/
/Platforms/*/Intermediate/

# Unreal's generated IDE projects and databases.
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# ------------------------------ OS / editor junk ------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vs/
.vscode/
.idea/

# ------------------------------ .NET / test harness ---------------------------
# NOTE: the Tests/ csproj files are hand-authored dev harnesses for the two
# engine-free cores. Their output must never be committed. Unlike Unity, Unreal
# writes a .csproj per module when you generate project files, so the blanket
# *.csproj rule below exists for that - and the exceptions keep the two harness
# projects, without which a fresh clone cannot build or run its own tests.
Tests/**/bin/
Tests/**/obj/
**/TestResults/
*.trx
*.coverage
*.nupkg
*.csproj
!Tests/Shadowbound.Core.Build/Shadowbound.Core.Build.csproj
!Tests/Shadowbound.Core.Tests/Shadowbound.Core.Tests.csproj

# The compiled C++ core test binary.
Tests/ShadowboundCore.Cpp/bin/

# Local override files
*.local.json
.env
.env.*
